{
  "name": "veraci",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-first verification for reproducible CI failures and human-approved fixes.",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "build": "npm run build --workspace=@veraci/api",
    "typecheck": "npm run typecheck --workspace=@veraci/api",
    "test": "npm run test --workspace=@veraci/api",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "start:api": "npm run start --workspace=@veraci/api",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{js,ts,json}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json}\""
  },
  "allowScripts": {
    "@swc/core": false,
    "@scarf/scarf": false
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.0"
  },
  "prettier": {
    "singleQuote": true
  }
}
