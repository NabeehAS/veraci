{
  "name": "veraci",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-first verification for reproducible CI failures and human-approved fixes.",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "build": "npm run build --workspace=@veraci/api",
    "typecheck": "npm run typecheck --workspace=@veraci/api",
    "test": "npm run test --workspace=@veraci/api",
    "check": "npm run typecheck && npm test && npm run build",
    "start:api": "npm run start --workspace=@veraci/api"
  },
  "allowScripts": {
    "@swc/core": false
  }
}
